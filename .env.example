# Run scripts/start-three-tier.ps1 to create .env with a random local password.
# For manual setup, set POSTGRES_PASSWORD to a long URL-safe random value.
POSTGRES_USER=comp_review
POSTGRES_PASSWORD=
POSTGRES_DB=comp_review
CORS_ORIGINS=http://localhost:8080
# Compose uses same-origin /api through nginx; no public backend URL is required.
DEMO_MODE=true
